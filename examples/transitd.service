# stm_tracker_widget: live STM bus and métro departures for KDE Plasma 6
# https://github.com/TCurrie11/stm_tracker_widget
#
# File:    examples/transitd.service
# Purpose: systemd user unit that starts transitd at login.
# Author:  TCurrie11 (https://github.com/TCurrie11)
# Version: 0.1.0
# Created: 2026-10-14
# Updated: 2026-10-14
# License: GPL-2.0-or-later
#
# systemd user service for transitd. Install with:
#
#   go build -o ~/.local/bin/transitd ./cmd/transitd
#   cp examples/transitd.service ~/.config/systemd/user/
#   systemctl --user enable --now transitd
#
# Logs: journalctl --user -u transitd -f

[Unit]
Description=STM transit widget backend
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/.local/bin/transitd serve
# STM_API_KEY=... ; the leading '-' lets it run schedule-only without one.
EnvironmentFile=-%h/.config/stm-transit/secrets.env
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
